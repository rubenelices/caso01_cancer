{
  "experiment_id": "SMOKE_E51_label_smoothing_cuda",
  "description": "Smoke técnico GPU de E51_label_smoothing_cuda, no calidad científica",
  "data": {
    "root": "breastdcedl",
    "validation_fold": 0,
    "batch_size": 16,
    "num_workers": 0,
    "pin_memory": false,
    "train_patients_per_class": 4,
    "validation_patients_per_class": 2
  },
  "model": {
    "channels": [
      16,
      32,
      64,
      128
    ],
    "convolutions_per_block": 2,
    "kernel_size": 3,
    "use_batch_norm": true,
    "dropout": 0.3,
    "pool_position": "between_convolutions",
    "input_representation": "pre_differences"
  },
  "training": {
    "epochs": 2,
    "learning_rate": 0.001,
    "weight_decay": 0.001,
    "loss": "normal",
    "threshold": 0.5,
    "seed": 42,
    "early_stopping_patience": 3,
    "scheduler_patience": 3,
    "scheduler_factor": 0.5,
    "monitor": "patient_roc_auc",
    "mixed_precision": false,
    "label_smoothing": {
      "enabled": true,
      "epsilon": 0.1
    }
  },
  "output_dir": "reports/smoke/SMOKE_E51_label_smoothing_cuda",
  "checkpoint_dir": "checkpoints/SMOKE_E51_label_smoothing_cuda"
}
