{
  "experiment_id": "E03_base_weighted",
  "description": "Misma arquitectura base; BCEWithLogitsLoss ponderada con N0/N1 de train",
  "data": {
    "root": "breastdcedl",
    "validation_fold": 0,
    "batch_size": 16,
    "num_workers": 4,
    "pin_memory": true
  },
  "model": {
    "channels": [16, 32, 64, 128],
    "convolutions_per_block": 2,
    "kernel_size": 3,
    "use_batch_norm": true,
    "dropout": 0.3
  },
  "training": {
    "epochs": 50,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "loss": "weighted",
    "threshold": 0.5,
    "seed": 42,
    "early_stopping_patience": 8,
    "scheduler_patience": 3,
    "scheduler_factor": 0.5,
    "monitor": "patient_roc_auc",
    "mixed_precision": true
  },
  "output_dir": "reports/experiments/E03_base_weighted/fold_0_seed_42",
  "checkpoint_dir": "checkpoints/E03_base_weighted/fold_0_seed_42"
}
