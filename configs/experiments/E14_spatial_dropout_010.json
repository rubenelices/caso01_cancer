{
  "experiment_id": "E14_spatial_dropout_010",
  "description": "E13_50epochs con Dropout2d 0.1 al final de cada bloque; unica variable modificada",
  "data": {
    "root": "breastdcedl",
    "validation_fold": 0,
    "batch_size": 16,
    "num_workers": 4,
    "pin_memory": true
  },
  "model": {
    "channels": [
      16,
      32,
      64,
      128
    ],
    "convolutions_per_block": 2,
    "kernel_size": 3,
    "use_batch_norm": true,
    "dropout": 0.3,
    "pool_position": "between_convolutions",
    "input_representation": "pre_differences",
    "spatial_dropout": 0.1
  },
  "training": {
    "epochs": 50,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "loss": "normal",
    "threshold": 0.5,
    "seed": 42,
    "early_stopping_patience": 51,
    "scheduler_patience": 3,
    "scheduler_factor": 0.5,
    "monitor": "patient_roc_auc",
    "mixed_precision": true
  },
  "output_dir": "reports/experiments/E14_spatial_dropout_010/fold_0_seed_42",
  "checkpoint_dir": "checkpoints/E14_spatial_dropout_010/fold_0_seed_42"
}
