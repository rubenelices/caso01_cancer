{
  "experiment_id": "E48_ema_mac",
  "description": "E19 con promedio exponencial de pesos y buffers flotantes (decay0.99); validación/checkpoint/Plateau sobre copia EMA desde cero",
  "data": {
    "root": "breastdcedl",
    "validation_fold": 0,
    "batch_size": 16,
    "num_workers": 0,
    "pin_memory": false
  },
  "model": {
    "channels": [
      16,
      32,
      64,
      128
    ],
    "convolutions_per_block": 2,
    "kernel_size": 3,
    "use_batch_norm": true,
    "dropout": 0.3,
    "pool_position": "between_convolutions",
    "input_representation": "pre_differences"
  },
  "training": {
    "epochs": 50,
    "learning_rate": 0.001,
    "weight_decay": 0.001,
    "loss": "normal",
    "threshold": 0.5,
    "seed": 42,
    "early_stopping_patience": 10,
    "scheduler_patience": 3,
    "scheduler_factor": 0.5,
    "monitor": "patient_roc_auc",
    "mixed_precision": false,
    "ema": {
      "enabled": true,
      "decay": 0.99
    }
  },
  "output_dir": "reports/experiments/E48_ema_mac/fold_0_seed_42",
  "checkpoint_dir": "checkpoints/E48_ema_mac/fold_0_seed_42"
}
